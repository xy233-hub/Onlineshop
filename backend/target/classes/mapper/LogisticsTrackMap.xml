<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.onlineshop.mapper.LogisticsTrackMapper">

    <resultMap id="LogisticsTrackMap" type="com.example.onlineshop.entity.LogisticsTrack">
        <id property="trackId" column="track_id"/>
        <result property="purchaseId" column="purchase_id"/>
        <result property="trackTime" column="track_time"/>
        <result property="trackContent" column="track_content"/>
        <result property="trackLocation" column="track_location"/>
        <result property="trackStatus" column="track_status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.onlineshop.entity.LogisticsTrack" useGeneratedKeys="true" keyProperty="trackId">
        INSERT INTO logistics_tracks(purchase_id, track_time, track_content, track_location, track_status)
        VALUES(#{purchaseId}, #{trackTime}, #{trackContent}, #{trackLocation}, #{trackStatus})
    </insert>

    <insert id="insertInitialTrack">
        INSERT INTO logistics_tracks(purchase_id, track_time, track_content, track_status)
        VALUES(#{purchaseId}, NOW(), #{content}, '已发货')
    </insert>

    <select id="findByPurchaseId" parameterType="int" resultMap="LogisticsTrackMap">
        SELECT * FROM logistics_tracks
        WHERE purchase_id = #{purchaseId}
        ORDER BY track_time ASC
    </select>

</mapper>